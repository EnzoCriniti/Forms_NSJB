direction: down
style.fill: "#f8fafc"
style.stroke: "#cbd5e1"
style.stroke-width: 2

compose: {
  label: "docker compose up -d --build\nsobe a stack oficial"
  style.fill: "#eff6ff"
  style.stroke: "#60a5fa"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
}

postgres: {
  label: "postgres\naguarda ficar healthy"
  style.fill: "#f0fdf4"
  style.stroke: "#22c55e"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
}

backend: {
  label: "backend\ncarrega config e inicia a API"
  style.fill: "#ecfeff"
  style.stroke: "#14b8a6"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
}

frontend: {
  label: "frontend\nexpõe a interface React"
  style.fill: "#fff7ed"
  style.stroke: "#fb923c"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
}

legacy: {
  label: "SQLite legado\nimportacao unica se houver snapshot"
  style.fill: "#fef2f2"
  style.stroke: "#ef4444"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
}

compose -> postgres
postgres -> backend
backend -> frontend
legacy -> backend: "bootstrap"
