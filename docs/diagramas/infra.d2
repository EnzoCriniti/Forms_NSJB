vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 5
  }
}

direction: right
style.fill: "#f8fafc"
style.stroke: "#cbd5e1"
style.stroke-width: 2
style.border-radius: 18
style.double-border: true
style.font-size: 18

usuario: {
  label: "Usuario"
  style.fill: "#fff7ed"
  style.stroke: "#fb923c"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
  style.font-size: 18
}

frontend: {
  label: "Frontend\nReact + Vite"
  style.fill: "#eff6ff"
  style.stroke: "#60a5fa"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
  style.font-size: 18
}

backend: {
  label: "Backend\nAPI + regras"
  style.fill: "#ecfeff"
  style.stroke: "#14b8a6"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
  style.font-size: 18
}

postgres: {
  label: "PostgreSQL"
  style.fill: "#f0fdf4"
  style.stroke: "#22c55e"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
  style.font-size: 18
}

sqlite_legado: {
  label: "SQLite legado"
  style.fill: "#fef2f2"
  style.stroke: "#ef4444"
  style.stroke-width: 2
  style.shadow: true
  style.border-radius: 16
  style.font-size: 18
}

usuario -> frontend: "usa"
frontend -> backend: "API local"
backend -> postgres: "grava e consulta"
sqlite_legado -> backend: "snapshot inicial"
