{
  "name": "nsjb-forms-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run docker:up",
    "dev:local": "node scripts/dev.mjs",
    "dev:client": "vite --config frontend/vite.config.js --host 0.0.0.0",
    "dev:server": "node backend/index.mjs",
    "docker:build": "docker compose -f docker/compose.yml build",
    "docker:up": "docker compose -f docker/compose.yml up -d --build",
    "docker:down": "docker compose -f docker/compose.yml down",
    "docker:restart": "docker compose -f docker/compose.yml down && docker compose -f docker/compose.yml up -d --build",
    "docker:logs": "docker compose -f docker/compose.yml logs -f",
    "docker:ps": "docker compose -f docker/compose.yml ps",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js --host 0.0.0.0",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "node --test tests/**/*.test.mjs",
    "test:ui": "vitest run --config frontend/vite.config.js",
    "test:load:local": "node scripts/load-local.mjs",
    "screenshot:local": "node tools/visual/screenshot-local.mjs",
    "test:forms": "node --test tests/api.integration.test.mjs && vitest run --config frontend/vite.config.js tests/ui/createFormScreen.test.jsx tests/ui/resultsScreen.test.jsx tests/ui/formsFlow.test.jsx tests/ui/formListScreen.test.jsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5"
  }
}
