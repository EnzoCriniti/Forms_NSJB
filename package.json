{
  "name": "nsjb-forms-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "node --test tests/**/*.test.mjs",
    "test:ui": "vitest run",
    "test:load:local": "node scripts/load-local.mjs",
    "screenshot:local": "node tools/visual/screenshot-local.mjs",
    "test:forms": "node --test tests/api.integration.test.mjs && vitest run tests/ui/createFormScreen.test.jsx tests/ui/resultsScreen.test.jsx tests/ui/formsFlow.test.jsx tests/ui/formListScreen.test.jsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5"
  }
}
